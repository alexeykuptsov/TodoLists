<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net7.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>TodoLists.Utils</AssemblyName>
        <RootNamespace>TodoLists.Utils</RootNamespace>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="JetBrains.Annotations" Version="2022.3.1" />
    </ItemGroup>

    <ItemGroup>
        <Analyzer Include="..\Analyzers\binRelease\net7.0\TodoList.Analyzers.dll" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="**\*.vue" />
        <AdditionalFiles Include="**\*.md" />
        <AdditionalFiles Include="**\*.js" />
        <AdditionalFiles Include="**\*.ts" />
    </ItemGroup>

</Project>
